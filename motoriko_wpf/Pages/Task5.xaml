<Page x:Class="motoriko_wpf.Pages.Task5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача 5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontWeight="Bold" FontSize="14"
                   Text="Задача 5. Сгенерировать массив M столбцов и N строк (от -10 до 10). Отсортировать по возрастанию и убыванию. Найти max и min."/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,15">
            <TextBlock Text="Строк N: " VerticalAlignment="Center"/>
            <TextBox Name="txtRows" Width="60"/>
            <TextBlock Text="Столбцов M: " VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox Name="txtCols" Width="60"/>
            <Button Name="btnGenerate" Content="Сгенерировать" Margin="10,0,0,0" Padding="10,3" Click="btnGenerate_Click"/>
            <Button Name="btnSort" Content="Сортировать" Margin="10,0,0,0" Padding="10,3" Click="btnSort_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Исходный массив:" FontWeight="Bold"/>
        <TextBox Grid.Row="3" Name="txtOriginal" IsReadOnly="True" Height="80"
                 TextWrapping="Wrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>

        <TextBlock Grid.Row="4" Text="Результаты:" FontWeight="Bold"/>
        <TextBox Grid.Row="5" Name="txtResult" IsReadOnly="True" Height="180"
                 TextWrapping="Wrap" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Page>